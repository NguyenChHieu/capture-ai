{
  "manifest_version": 3,
  "name": "Capture Organizer",
  "version": "0.1.0",
  "description": "Save selected text to Capture Organizer",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
